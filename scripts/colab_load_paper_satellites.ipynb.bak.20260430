 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# PaperMind v4 — Drive parquet → Supabase **Faz 2** satellite facts\n",
    "\n",
    "**Migration**: `db/migrations/0004_paper_satellite_facts.sql`  \n",
    "**Hedef tablolar**: 3 paper-level satellite (FK fact_paper_id_card)\n",
    "- `fact_paper_sentence_role` (24.87M × 13, W-23)\n",
    "- `fact_paper_d_estra` (24.87M × 13, W-26a)\n",
    "- `fact_paper_ref_age` (16.70M × 6, W-17)\n",
    "\n",
    "**Tier**: Pro + Compute **2XL**  \n",
    "**Beklenen süre**: ~1.5-2 saat (sentence_role ~30 dk + d_estra ~40 dk + ref_age ~25 dk)  \n",
    "**Önkoşul**: **Faz 1 (PaperCard) tamamen yüklü olmalı** (24.87M paper_id'ler FK için).  \n",
    "**Drive yolları**:\n",
    "- `~/Dataleak/facts/fact_paper_sentence_role.parquet`\n",
    "- `~/Dataleak/facts/fact_paper_d_estra.parquet`\n",
    "- `~/Dataleak/N09c/fact_paper_ref_age.parquet` ← **N09c/ subdir'de, facts/ değil!**"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 1 — Setup (Drive + install + DB connection + Faz 1 önkoşul check)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive, userdata\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "!pip -q install psycopg2-binary==2.9.9 pandas==2.2.2 pyarrow==17.0.0\n",
    "\n",
    "import os, json, math, time, sys\n",
    "import pandas as pd\n",
    "import pyarrow.parquet as pq\n",
    "import psycopg2\n",
    "from psycopg2.extras import execute_values\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "DB_URL = userdata.get('SUPABASE_DB_URL')\n",
    "assert DB_URL and DB_URL.startswith('postgresql://'), 'Colab Secrets → SUPABASE_DB_URL (Session Pooler)'\n",
    "\n",
    "DRIVE_ROOT = '/content/drive/MyDrive/Dataleak'\n",
    "PATHS = {\n",
    "    'fact_paper_sentence_role': f'{DRIVE_ROOT}/facts/fact_paper_sentence_role.parquet',\n",
    "    'fact_paper_d_estra':       f'{DRIVE_ROOT}/facts/fact_paper_d_estra.parquet',\n",
    "    'fact_paper_ref_age':       f'{DRIVE_ROOT}/N09c/fact_paper_ref_age.parquet',\n",
    "}\n",
    "\n",
    "CHUNK = 50_000\n",
    "PAGE_SIZE = 5_000\n",
    "BATCH_ROWS = 500_000\n",
    "\n",
    "for name, path in PATHS.items():\n",
    "    exists = os.path.exists(path)\n",
    "    size_gb = os.path.getsize(path) / 1e9 if exists else 0\n",
    "    print(f\"  {'✓' if exists else '✗'}  {name:30s} {path}  ({size_gb:.2f} GB)\")\n",
    "\n",
    "with psycopg2.connect(DB_URL) as conn, conn.cursor() as cur:\n",
    "    cur.execute('SELECT COUNT(*) FROM public.fact_paper_id_card;')\n",
    "    pc_count = cur.fetchone()[0]\n",
    "    print(f'\\nfact_paper_id_card row count: {pc_count:,}')\n",
    "    assert pc_count > 24_000_000, f'Faz 1 önkoşul FAIL — PaperCard {pc_count:,} < 24M; önce colab_load_paper_anchor.ipynb tamamla.'\n",
    "    print('✓ Faz 1 önkoşul tamam (PaperCard yüklü)')\n",
    "\n",
    "    cur.execute('SELECT version FROM public.schema_migrations ORDER BY applied_at;')\n",
    "    print('Applied migrations:', [r[0] for r in cur.fetchall()])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 2 — Schema audit (3 parquet)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for name, path in PATHS.items():\n",
    "    pf = pq.ParquetFile(path)\n",
    "    print(f'=== {name} ===')\n",
    "    print(f'  total_rows: {pf.metadata.num_rows:,}')\n",
    "    print(f'  row_groups: {pf.metadata.num_row_groups}')\n",
    "    print(f'  columns:    {pf.schema_arrow.names}')\n",
    "    head = next(pf.iter_batches(batch_size=2)).to_pandas()\n",
    "    print(f'  head:\\n{head}\\n')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 3 — Migration 0004 uygula (3 satellite tablo DDL)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "MIGRATION_0004 = r'''\n",
    "CREATE TABLE IF NOT EXISTS public.fact_paper_sentence_role (\n",
    "  paper_id              text PRIMARY KEY REFERENCES public.fact_paper_id_card(paper_id) ON DELETE CASCADE,\n",
    "  n_sentences_total     smallint NOT NULL DEFAULT 0,\n",
    "  n_background          smallint NOT NULL DEFAULT 0,\n",
    "  n_objective           smallint NOT NULL DEFAULT 0,\n",
    "  n_method              smallint NOT NULL DEFAULT 0,\n",
    "  n_result              smallint NOT NULL DEFAULT 0,\n",
    "  n_conclusion          smallint NOT NULL DEFAULT 0,\n",
    "  mean_conf_background  real,\n",
    "  mean_conf_objective   real,\n",
    "  mean_conf_method      real,\n",
    "  mean_conf_result      real,\n",
    "  mean_conf_conclusion  real,\n",
    "  dominant_role         text NOT NULL,\n",
    "  CHECK (dominant_role IN ('BACKGROUND','OBJECTIVE','METHOD','RESULT','CONCLUSION','NONE'))\n",
    ");\n",
    "CREATE INDEX IF NOT EXISTS idx_sent_role_dom  ON public.fact_paper_sentence_role(dominant_role);\n",
    "CREATE INDEX IF NOT EXISTS idx_sent_role_meth ON public.fact_paper_sentence_role(n_method DESC) WHERE n_method > 0;\n",
    "ALTER TABLE public.fact_paper_sentence_role ENABLE ROW LEVEL SECURITY;\n",
    "DROP POLICY IF EXISTS sent_role_read_all      ON public.fact_paper_sentence_role;\n",
    "DROP POLICY IF EXISTS sent_role_write_service ON public.fact_paper_sentence_role;\n",
    "CREATE POLICY sent_role_read_all      ON public.fact_paper_sentence_role FOR SELECT TO authenticated USING (true);\n",
    "CREATE POLICY sent_role_write_service ON public.fact_paper_sentence_role FOR ALL    TO service_role  USING (true) WITH CHECK (true);\n",
    "\n",
    "CREATE TABLE IF NOT EXISTS public.fact_paper_d_estra (\n",
    "  paper_id            text PRIMARY KEY REFERENCES public.fact_paper_id_card(paper_id) ON DELETE CASCADE,\n",
    "  ts_p                real,\n",
    "  rising_signal       real,\n",
    "  r                   real,\n",
    "  r_low               real,\n",
    "  r_high              real,\n",
    "  e                   real,\n",
    "  e_low               real,\n",
    "  e_high              real,\n",
    "  d_scalar            real,\n",
    "  d_scalar_low        real,\n",
    "  d_scalar_high       real,\n",
    "  gate_d_triggered    boolean NOT NULL DEFAULT false\n",
    ");\n",
    "CREATE INDEX IF NOT EXISTS idx_d_estra_d    ON public.fact_paper_d_estra(d_scalar DESC) WHERE d_scalar IS NOT NULL;\n",
    "CREATE INDEX IF NOT EXISTS idx_d_estra_r    ON public.fact_paper_d_estra(r DESC) WHERE r IS NOT NULL;\n",
    "CREATE INDEX IF NOT EXISTS idx_d_estra_e    ON public.fact_paper_d_estra(e DESC) WHERE e IS NOT NULL;\n",
    "CREATE INDEX IF NOT EXISTS idx_d_estra_gate ON public.fact_paper_d_estra(gate_d_triggered) WHERE gate_d_triggered = true;\n",
    "ALTER TABLE public.fact_paper_d_estra ENABLE ROW LEVEL SECURITY;\n",
    "DROP POLICY IF EXISTS d_estra_read_all      ON public.fact_paper_d_estra;\n",
    "DROP POLICY IF EXISTS d_estra_write_service ON public.fact_paper_d_estra;\n",
    "CREATE POLICY d_estra_read_all      ON public.fact_paper_d_estra FOR SELECT TO authenticated USING (true);\n",
    "CREATE POLICY d_estra_write_service ON public.fact_paper_d_estra FOR ALL    TO service_role  USING (true) WITH CHECK (true);\n",
    "\n",
    "CREATE TABLE IF NOT EXISTS public.fact_paper_ref_age (\n",
    "  paper_id            text PRIMARY KEY REFERENCES public.fact_paper_id_card(paper_id) ON DELETE CASCADE,\n",
    "  mean_ref_age        double precision,\n",
    "  std_ref_age         double precision,\n",
    "  median_ref_age      double precision,\n",
    "  p_recent_5y         double precision,\n",
    "  n_refs_inside       integer NOT NULL DEFAULT 0,\n",
    "  CHECK (p_recent_5y IS NULL OR (p_recent_5y >= 0 AND p_recent_5y <= 1))\n",
    ");\n",
    "CREATE INDEX IF NOT EXISTS idx_ref_age_mean   ON public.fact_paper_ref_age(mean_ref_age) WHERE mean_ref_age IS NOT NULL;\n",
    "CREATE INDEX IF NOT EXISTS idx_ref_age_recent ON public.fact_paper_ref_age(p_recent_5y DESC) WHERE p_recent_5y IS NOT NULL;\n",
    "CREATE INDEX IF NOT EXISTS idx_ref_age_n      ON public.fact_paper_ref_age(n_refs_inside DESC);\n",
    "ALTER TABLE public.fact_paper_ref_age ENABLE ROW LEVEL SECURITY;\n",
    "DROP POLICY IF EXISTS ref_age_read_all      ON public.fact_paper_ref_age;\n",
    "DROP POLICY IF EXISTS ref_age_write_service ON public.fact_paper_ref_age;\n",
    "CREATE POLICY ref_age_read_all      ON public.fact_paper_ref_age FOR SELECT TO authenticated USING (true);\n",
    "CREATE POLICY ref_age_write_service ON public.fact_paper_ref_age FOR ALL    TO service_role  USING (true) WITH CHECK (true);\n",
    "\n",
    "INSERT INTO public.schema_migrations (version, description)\n",
    "VALUES ('0004_paper_satellite_facts',\n",
    "        'fact_paper_sentence_role (24.87M) + fact_paper_d_estra (24.87M) + fact_paper_ref_age (16.70M)')\n",
    "ON CONFLICT (version) DO NOTHING;\n",
    "'''\n",
    "\n",
    "with psycopg2.connect(DB_URL) as conn, conn.cursor() as cur:\n",
    "    cur.execute(MIGRATION_0004)\n",
    "    conn.commit()\n",
    "print('✓ migration 0004 applied')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 4 — Genel upload helper (3 cell aynı pattern; tek util fonksiyon)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _fnum(v):\n",
    "    if v is None: return None\n",
    "    try:\n",
    "        f = float(v)\n",
    "        return None if math.isnan(f) else f\n",
    "    except (TypeError, ValueError):\n",
    "        return None\n",
    "\n",
    "def _iint(v):\n",
    "    if v is None: return None\n",
    "    try:\n",
    "        f = float(v)\n",
    "        return None if math.isnan(f) else int(f)\n",
    "    except (TypeError, ValueError):\n",
    "        return None\n",
    "\n",
    "def _ibool(v):\n",
    "    if v is None: return None\n",
    "    if isinstance(v, bool): return v\n",
    "    try: return bool(int(v))\n",
    "    except (TypeError, ValueError): return None\n",
    "\n",
    "def stream_upload(table, path, sql, template, row_builder,\n",
    "                  total_expected=None, batch_rows=BATCH_ROWS,\n",
    "                  chunk=CHUNK, page_size=PAGE_SIZE):\n",
    "    pf = pq.ParquetFile(path)\n",
    "    total = pf.metadata.num_rows\n",
    "    print(f'\\n=== upload {table}: {total:,} rows ({total/chunk:.0f} chunks of {chunk:,}) ===')\n",
    "    if total_expected and abs(total - total_expected) > 10:\n",
    "        print(f'  ⚠ row count mismatch envanter: expected ~{total_expected:,}, got {total:,}')\n",
    "    t0 = time.time()\n",
    "    rows_done = 0\n",
    "    skipped = 0\n",
    "    with psycopg2.connect(DB_URL) as conn, conn.cursor() as cur:\n",
    "        for batch in pf.iter_batches(batch_size=batch_rows):\n",
    "            df = batch.to_pandas()\n",
    "            built = []\n",
    "            for r in df.itertuples(index=False):\n",
    "                row = row_builder(r)\n",
    "                if row is None:\n",
    "                    skipped += 1\n",
    "                    continue\n",
    "                built.append(row)\n",
    "            for i in range(0, len(built), chunk):\n",
    "                execute_values(cur, sql, built[i:i+chunk],\n",
    "                               template=template, page_size=page_size)\n",
    "                rows_done += min(chunk, len(built) - i)\n",
    "                elapsed = time.time() - t0\n",
    "                rate = rows_done / elapsed if elapsed > 0 else 0\n",
    "                eta_s = (total - rows_done) / rate if rate > 0 else 0\n",
    "                eta_str = str(timedelta(seconds=int(eta_s)))\n",
    "                stamp = datetime.now().strftime('%H:%M:%S')\n",
    "                print(f'  [{stamp}] {rows_done:>11,}/{total:,}  '\n",
    "                      f'({100*rows_done/total:5.1f}%)  '\n",
    "                      f'rate={rate:>7,.0f}/s  ETA={eta_str}', flush=True)\n",
    "            conn.commit()\n",
    "            del df, built\n",
    "    print(f'\\n✓ {table} uploaded in {timedelta(seconds=int(time.time()-t0))}  (skipped={skipped:,})')\n",
    "    with psycopg2.connect(DB_URL) as conn, conn.cursor() as cur:\n",
    "        cur.execute(f'SELECT COUNT(*) FROM public.{table};')\n",
    "        print(f'  DB count: {cur.fetchone()[0]:,}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 5 — Upload **fact_paper_sentence_role** (24.87M, ~30 dk @ 2XL)\n",
    "\n",
    "Parquet kolon adları envanter §10.1'de UPPER (n_BACKGROUND, mean_conf_BACKGROUND...). Postgres tarafı lowercase (idiomatic). row_builder lowercase'e map eder."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ROLES = ('BACKGROUND','OBJECTIVE','METHOD','RESULT','CONCLUSION','NONE')\n",
    "\n",
    "def _norm_role(v):\n",
    "    if v is None: return 'NONE'\n",
    "    s = str(v).strip().upper()\n",
    "    return s if s in ROLES else 'NONE'\n",
    "\n",
    "def _build_sentence_role(r):\n",
    "    return (\n",
    "        str(r.paper_id),\n",
    "        _iint(r.n_sentences_total) or 0,\n",
    "        _iint(getattr(r, 'n_BACKGROUND', None)) or 0,\n",
    "        _iint(getattr(r, 'n_OBJECTIVE',  None)) or 0,\n",
    "        _iint(getattr(r, 'n_METHOD',     None)) or 0,\n",
    "        _iint(getattr(r, 'n_RESULT',     None)) or 0,\n",
    "        _iint(getattr(r, 'n_CONCLUSION', None)) or 0,\n",
    "        _fnum(getattr(r, 'mean_conf_BACKGROUND', None)),\n",
    "        _fnum(getattr(r, 'mean_conf_OBJECTIVE',  None)),\n",
    "        _fnum(getattr(r, 'mean_conf_METHOD',     None)),\n",
    "        _fnum(getattr(r, 'mean_conf_RESULT',     None)),\n",
    "        _fnum(getattr(r, 'mean_conf_CONCLUSION', None)),\n",
    "        _norm_role(r.dominant_role),\n",
    "    )\n",
    "\n",
    "SENT_SQL = '''\n",
    "INSERT INTO public.fact_paper_sentence_role\n",
    "  (paper_id, n_sentences_total, n_background, n_objective, n_method, n_result, n_conclusion,\n",
    "   mean_conf_background, mean_conf_objective, mean_conf_method, mean_conf_result, mean_conf_conclusion,\n",
    "   dominant_role)\n",
    "VALUES %s\n",
    "ON CONFLICT (paper_id) DO NOTHING;\n",
    "'''\n",
    "SENT_TMPL = '(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)'\n",
    "\n",
    "stream_upload(\n",
    "    table='fact_paper_sentence_role',\n",
    "    path=PATHS['fact_paper_sentence_role'],\n",
    "    sql=SENT_SQL, template=SENT_TMPL,\n",
    "    row_builder=_build_sentence_role,\n",
    "    total_expected=24_867_210,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 6 — Upload **fact_paper_d_estra** (24.87M, ~40 dk @ 2XL)\n",
    "\n",
    "Parquet → Postgres alan eşleme: `R/E/d_scalar` lowercase'e (R→r, E→e, d_scalar zaten). Bant alanları (R_low/R_high) → r_low/r_high."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _build_d_estra(r):\n",
    "    return (\n",
    "        str(r.paper_id),\n",
    "        _fnum(getattr(r, 'TS_p', None)),\n",
    "        _fnum(r.rising_signal),\n",
    "        _fnum(getattr(r, 'R',      None)),\n",
    "        _fnum(getattr(r, 'R_low',  None)),\n",
    "        _fnum(getattr(r, 'R_high', None)),\n",
    "        _fnum(getattr(r, 'E',      None)),\n",
    "        _fnum(getattr(r, 'E_low',  None)),\n",
    "        _fnum(getattr(r, 'E_high', None)),\n",
    "        _fnum(r.d_scalar),\n",
    "        _fnum(r.d_scalar_low),\n",
    "        _fnum(r.d_scalar_high),\n",
    "        _ibool(r.gate_d_triggered) if _ibool(r.gate_d_triggered) is not None else False,\n",
    "    )\n",
    "\n",
    "DEST_SQL = '''\n",
    "INSERT INTO public.fact_paper_d_estra\n",
    "  (paper_id, ts_p, rising_signal, r, r_low, r_high, e, e_low, e_high,\n",
    "   d_scalar, d_scalar_low, d_scalar_high, gate_d_triggered)\n",
    "VALUES %s\n",
    "ON CONFLICT (paper_id) DO NOTHING;\n",
    "'''\n",
    "DEST_TMPL = '(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)'\n",
    "\n",
    "stream_upload(\n",
    "    table='fact_paper_d_estra',\n",
    "    path=PATHS['fact_paper_d_estra'],\n",
    "    sql=DEST_SQL, template=DEST_TMPL,\n",
    "    row_builder=_build_d_estra,\n",
    "    total_expected=24_867_210,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 7 — Upload **fact_paper_ref_age** (16.70M, ~25 dk @ 2XL)\n",
    "\n",
    "%67.1 coverage (atıfsız ya da ref-yıl bilgisi yok 8.17M paper FK YOK — INSERT ON CONFLICT DO NOTHING ile sessiz geçilir, FK violation olmaz çünkü ref_age 16.70M zaten corpus alt-kümesi)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _build_ref_age(r):\n",
    "    return (\n",
    "        str(r.paper_id),\n",
    "        _fnum(r.mean_ref_age),\n",
    "        _fnum(r.std_ref_age),\n",
    "        _fnum(r.median_ref_age),\n",
    "        _fnum(r.p_recent_5y),\n",
    "        _iint(r.n_refs_inside) or 0,\n",
    "    )\n",
    "\n",
    "REF_SQL = '''\n",
    "INSERT INTO public.fact_paper_ref_age\n",
    "  (paper_id, mean_ref_age, std_ref_age, median_ref_age, p_recent_5y, n_refs_inside)\n",
    "VALUES %s\n",
    "ON CONFLICT (paper_id) DO NOTHING;\n",
    "'''\n",
    "REF_TMPL = '(%s,%s,%s,%s,%s,%s)'\n",
    "\n",
    "stream_upload(\n",
    "    table='fact_paper_ref_age',\n",
    "    path=PATHS['fact_paper_ref_age'],\n",
    "    sql=REF_SQL, template=REF_TMPL,\n",
    "    row_builder=_build_ref_age,\n",
    "    total_expected=16_698_232,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 8 — Verify (3 row count + dominant_role + d_scalar dist + ref_age coverage)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "EXPECTED = {\n",
    "    'fact_paper_sentence_role': 24_867_210,\n",
    "    'fact_paper_d_estra':       24_867_210,\n",
    "    'fact_paper_ref_age':       16_698_232,\n",
    "}\n",
    "\n",
    "with psycopg2.connect(DB_URL) as conn, conn.cursor() as cur:\n",
    "    print('=== Row counts ===')\n",
    "    for tbl, exp in EXPECTED.items():\n",
    "        cur.execute(f'SELECT COUNT(*) FROM public.{tbl};')\n",
    "        actual = cur.fetchone()[0]\n",
    "        delta = actual - exp\n",
    "        flag = '✓' if abs(delta) < 1000 else ('⚠' if abs(delta) < 100000 else '✗')\n",
    "        print(f'  {flag} {tbl:30s} expected={exp:>12,}  actual={actual:>12,}  Δ={delta:+,}')\n",
    "\n",
    "    print('\\n=== sentence_role: dominant_role histogram (envanter: BG %39 / OBJ %31 / CONCL %12 / RES %11 / METH %7) ===')\n",
    "    cur.execute('SELECT dominant_role, COUNT(*) FROM public.fact_paper_sentence_role GROUP BY dominant_role ORDER BY 2 DESC;')\n",
    "    rows = cur.fetchall()\n",
    "    total = sum(r[1] for r in rows) or 1\n",
    "    for d, c in rows:\n",
    "        print(f'  {d:12s}: {c:>11,}  ({100*c/total:5.2f}%)')\n",
    "\n",
    "    print('\\n=== d_estra: d_scalar quantiles ===')\n",
    "    cur.execute('''SELECT\n",
    "      percentile_cont(ARRAY[0.1,0.25,0.5,0.75,0.9])\n",
    "        WITHIN GROUP (ORDER BY d_scalar)\n",
    "      FROM public.fact_paper_d_estra TABLESAMPLE BERNOULLI (0.5);''')\n",
    "    print(f'  d_scalar [p10,p25,p50,p75,p90]: {cur.fetchone()[0]}')\n",
    "    cur.execute('SELECT COUNT(*) FILTER (WHERE gate_d_triggered) AS gated, COUNT(*) FROM public.fact_paper_d_estra;')\n",
    "    g, t = cur.fetchone()\n",
    "    print(f'  gate_d_triggered: {g:,} / {t:,}  ({100*g/t:.2f}%)')\n",
    "\n",
    "    print('\\n=== ref_age: coverage check ===')\n",
    "    cur.execute('SELECT COUNT(*) FROM public.fact_paper_ref_age;')\n",
    "    ra = cur.fetchone()[0]\n",
    "    cur.execute('SELECT COUNT(*) FROM public.fact_paper_id_card;')\n",
    "    pc = cur.fetchone()[0]\n",
    "    print(f'  ref_age coverage: {100*ra/pc:.1f}%  (envanter hedef %67.1)')\n",
    "    cur.execute('''SELECT\n",
    "      AVG(mean_ref_age)::numeric(6,2) AS mu,\n",
    "      AVG(p_recent_5y)::numeric(4,3) AS p5,\n",
    "      AVG(n_refs_inside)::numeric(7,1) AS n\n",
    "    FROM public.fact_paper_ref_age TABLESAMPLE BERNOULLI (1.0);''')\n",
    "    print(f'  sample 1%: mean_ref_age={cur.fetchone()}')\n",
    "\n",
    "    print('\\n=== Disk usage ===')\n",
    "    cur.execute('''SELECT relname, pg_size_pretty(pg_total_relation_size(oid)) FROM pg_class\n",
    "                   WHERE relname IN ('fact_paper_sentence_role','fact_paper_d_estra','fact_paper_ref_age')\n",
    "                     AND relkind='r' ORDER BY relname;''')\n",
    "    for n, s in cur.fetchall():\n",
    "        print(f'  {n}: {s}')\n",
    "\n",
    "print('\\n✓ Faz 2 (3 satellite) verify complete')"
   ]
