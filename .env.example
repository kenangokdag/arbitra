# PaperMind App — Environment template
# Production'da .env dosyası oluştur (commit etme — .gitignore'da)

# ===== APP =====
APP_ENV=development                  # development | staging | production
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_PORT=8000

# ===== Supabase (auth + memory + state) =====
# 2026-04-30: Modern API keys (publishable + secret); legacy anon/service_role + HS256 disable edildi
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=                # sb_publishable_... (frontend, RLS-safe)
SUPABASE_SECRET_KEY=                     # sb_secret_... (backend, RLS bypass)
# JWT verify: ES256 + JWKS endpoint (HS256 + JWT_SECRET artık kullanılmıyor)
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# ===== Pinecone (vector retrieval) =====
PINECONE_API_KEY=
PINECONE_INDEX_NAME=papers-bgem3
PINECONE_ENVIRONMENT=us-east-1
PINECONE_DIMENSION=1024
PINECONE_METRIC=cosine

# ===== Redis (cache + Celery broker) =====
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=2592000      # 30 gün özet, 7 gün sentez

# ===== Gemini LLM (F8 unified — DM-LLM-1) =====
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ===== LiteLLM router (F8 — DM-LLM-1) =====
LITELLM_TIMEOUT_SECONDS=30
LITELLM_CONFIG_PATH=config/litellm_models.yaml

# ===== LLM provider toggle (F14-S1 — DM-VTX-1/2) =====
# gemini = GEMINI_API_KEY ile (default, fail-safe) | vertex = Vertex AI (GCP kredisi)
LLM_PROVIDER=gemini
# Aşağıdakiler yalnız LLM_PROVIDER=vertex iken gerekir:
VERTEX_PROJECT=translate-500019
VERTEX_LOCATION=europe-west4
# SA JSON yolu (repo dışı; ADC). Örn: /Users/omer/Desktop/keys/translate-500019-arbitra-vertex.json
GOOGLE_APPLICATION_CREDENTIALS=

# ===== Claude yedek / fallback (F14-S2 — DM-VTX-5) =====
# Gemini/Vertex çağrısı başarısız olursa Sonnet 4.6'ya düş. Key boşsa pasif.
LLM_FALLBACK_ENABLED=true
ANTHROPIC_API_KEY=
PRESENTER_TR_MODEL=gemini-flash-tr
PRESENTER_EN_MODEL=gemini-flash-en
PRESENTER_ID_MODEL=gemini-flash-id

# ===== Reranker P007 (BGE-reranker-v2-m3 local) =====
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu                  # cpu | mps (Mac M-series) | cuda
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LEN=512

# ===== P008 Curator + faithfulness_gate =====
FAITHFULNESS_THRESHOLDS_PATH=config/faithfulness_thresholds.yaml

# ===== OpenAlex (.edu.tr polite pool) =====
OPENALEX_EMAIL=dr.ofrencber@gaziantep.edu.tr
OPENALEX_BASE_URL=https://api.openalex.org

# ===== Semantic Scholar (fallback, 2026-08-23'te gerçekten bağlandı) =====
# İKİ ayrı kapı var, İKİSİ de açık olmalı — S2_FALLBACK_ENABLED=false VEYA key
# boşsa S2 TAMAMEN DEVRE DIŞI (ağ çağrısı yapılmaz). Key'siz anonim kota canlı
# testte HEMEN 429 verdi. Ücretsiz key: https://www.semanticscholar.org/product/api#api-key-form
# Key aldıktan sonra AÇMA: SEMANTIC_SCHOLAR_API_KEY=<key> + S2_FALLBACK_ENABLED=true
S2_FALLBACK_ENABLED=false
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1

# ===== BGE embedding & reranker =====
BGE_M3_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== Sentry (observability) =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===== Frontend (web/.env.local) =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
