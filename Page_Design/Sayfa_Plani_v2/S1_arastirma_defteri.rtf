(1) VER\uc0\u304  KATMANI\
\
project_event tablosu (var oldu\uc0\u287 u varsay\u305 l\u305 rsa \u351 ema do\u287 rulamas\u305  zorunlu;\
yoksa Migration 0029 \'97 kapsam d\uc0\u305 \u351 \u305  plan oturumunda Omer onay\u305 yla):\
- id (uuid pk)\
- project_id (fk dim_project)\
- user_id (fk auth.users)\
- page_slug (text)              -- "5.1_yayin_formati", "4.2_bosluk_profili", ...\
- paper_id (text, nullable)     -- OpenAlex / havuz paper kimli\uc0\u287 i\
- event_type (text)             -- "kayit", "danismana_sor", "kutuphane_ekle", "not"\
- payload (jsonb)               -- not metni, etiketler, persona, sayfa snapshot anahtarlar\uc0\u305 \
- created_at (timestamptz)\
- resolved_at (timestamptz, nullable)   -- "h\'e2l\'e2 a\'e7\uc0\u305 k" digest'i i\'e7in\
\
\uc0\u304 ndeks: (user_id, project_id, created_at desc), (user_id, resolved_at)\
where resolved_at is null.\
\
LLM yok \'97 saf SQL. Maliyet \uc0\u8776  0.\
\
(2) BACKEND ENDPOINT \'97 UNIFIED\
\
POST /api/diary/event\
- Body: \{ project_id, page_slug, paper_id?, event_type, payload \}\
- 3 sayfa-i\'e7i buton bu tek endpoint'i \'e7a\uc0\u287 \u305 r\u305 r:\
  - "Ajandama Kaydet" \uc0\u8594  event_type="kayit"\
  - "Dan\uc0\u305 \u351 mana Sor"   \u8594  event_type="danismana_sor" (ve dan\u305 \u351 man ak\u305 \u351 \u305  tetiklenir)\
  - "K\'fct\'fcphaneme Ekle" \uc0\u8594  event_type="kutuphane_ekle" (ve dim_user_library upsert)\
\
GET /api/diary/timeline?project_id&from&to&page_slug&paper_id&tag\
- Zaman \'e7izgisi sayfalama (cursor-based, 50/sayfa)\
- Her sat\uc0\u305 r: \{ id, page_slug, paper_id, event_type, payload, created_at,\
              resolved_at, action_label("Geri D\'f6n \uc0\u8594  /sayfa") \}\
\
PATCH /api/diary/event/:id  (D\'fczenle / Kald\uc0\u305 r / Resolve)\
\
