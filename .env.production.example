# Arbitra — PRODUCTION env şablonu (deploy/render.yaml ile hizalı)
# ─────────────────────────────────────────────────────────────────────────────
# Tek doğruluk kaynağı: api/config.py (Settings). Bu dosya = dashboard'a girilecek
# değerlerin referansı. GERÇEK secret'ları BURAYA YAZMA — Render dashboard'da gir
# (render.yaml'da sync:false olanlar). Bu şablon commit'lenir; .env ve *.local ignore'lu.
#
# Boot kuralı (api/config_validation.py — APP_ENV=production iken FAIL-FAST):
#   ⛔ FATAL (eksikse uygulama AYAĞA KALKMAZ): FRONTEND_ORIGINS · auth provider · WAITLIST_BYPASS=false
#   ⚠️  WARN  (boot olur, ama): ADMIN_USER_IDS boş→admin uçları kapalı · REDIS_URL yok→kota fail-closed
# ─────────────────────────────────────────────────────────────────────────────

# ===== APP =====
APP_ENV=production                       # ⛔ production olmalı (fail-fast'i açar)
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
# APP_PORT — Render $PORT enjekte eder; set etme.

# ===== ⛔ PROD-FATAL: CORS =====
# Boş ise prod boot REDDEDİLİR. FE origin(ler)i, virgülle:
FRONTEND_ORIGINS=https://YOUR_FRONTEND_DOMAIN            # örn https://arbitra.app

# ===== ⛔ PROD-FATAL: Waitlist =====
WAITLIST_BYPASS=false                    # prod'da MUTLAKA false (true→boot reddedilir)

# ===== ⛔ PROD-FATAL: Auth provider (Supabase) — SECRET, dashboard =====
# JWKS (ES256, canon) VEYA JWT_SECRET (HS256, legacy) en az biri ZORUNLU.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=                 # sb_publishable_... (RLS-safe)
SUPABASE_SECRET_KEY=                      # sb_secret_... (backend, RLS bypass) — SECRET
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=                      # (legacy/test; JWKS varsa boş bırakılabilir)
# Migration apply (scripts/apply_migrations.sh) için doğrudan Postgres URL'i — SECRET
SUPABASE_DB_URL=postgresql://...          # 0042 + 0043 uygulamak için

# ===== F14 Hakemlik — IZOLE review Supabase projesi (Clarus) — SECRET =====
# Boş ise yukarıdaki default SUPABASE_* kullanılır. Review job'ları ayrı projede tutmak için:
REVIEW_SUPABASE_URL=                      # boş = default SUPABASE_URL
REVIEW_SUPABASE_SECRET_KEY=               # boş = default SUPABASE_SECRET_KEY

# ===== ⚠️ Admin paneli (tema/işler/istatistik) — virgül-ayrılmış user_id/sub =====
# Boş = admin uçları prod'da KAPALI (fail-closed). /admin/theme'i kullanacak admin'ler:
ADMIN_USER_IDS=                           # örn supabase-user-uuid-1,uuid-2

# ===== Redis (cache + kota) — Render managed (fromService inject) =====
# render.yaml redis servisinden otomatik gelir. Manuel deploy'da:
REDIS_URL=redis://YOUR_REDIS_HOST:6379/0  # boş/yanlış → cache degrade + kota fail-closed

# ===== LLM — Gemini (varsayılan provider) — SECRET =====
GEMINI_API_KEY=                           # SECRET
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
LLM_PROVIDER=gemini                       # gemini (default) | vertex
# LLM_PROVIDER=vertex iken: VERTEX_PROJECT, VERTEX_LOCATION, GOOGLE_APPLICATION_CREDENTIALS (SA JSON yolu)

# ===== LLM — Claude fallback (arıza yolu, opsiyonel) — SECRET =====
ANTHROPIC_API_KEY=                        # boş = fallback pasif (sistem kırılmaz)
LLM_FALLBACK_ENABLED=true

# ===== Vector retrieval — Pinecone — SECRET =====
PINECONE_API_KEY=                         # SECRET
PINECONE_INDEX_NAME=papers-bgem3
PINECONE_NAMESPACE=mdv1

# ===== Model warm-up (cold-start cezasını kaldırır; ~1GB RAM) =====
BGE_WARMUP_ENABLED=true                   # yeterli RAM'li prod instance'ında true

# ===== TTS — ElevenLabs (sesli dinlet, opsiyonel) — SECRET =====
ELEVENLABS_API_KEY=                       # boş = TTS özelliği pasif

# ===== Observability — Sentry — SECRET =====
SENTRY_DSN=                               # SECRET
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===== Akademik kaynaklar (polite pool — default'lar makul) =====
OPENALEX_EMAIL=dr.ofrencber@gaziantep.edu.tr
CROSSREF_EMAIL=dr.ofrencber@gaziantep.edu.tr
SEMANTIC_SCHOLAR_API_KEY=                 # SECRET — boşsa S2 fallback devre dışı (ağ çağrısı yapılmaz)

# ===== FRONTEND (web — ayrı deploy: Vercel/Render static) =====
# Next.js build env'i. Deploy edilen API URL'ine işaret etmeli:
NEXT_PUBLIC_API_URL=https://papermind-api.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # sb_publishable_... (FE, RLS-safe)
